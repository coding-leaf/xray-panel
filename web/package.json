{
  "name": "xray-panel-web",
  "version": "2.6.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css}\" index.html"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "lucide-vue-next": "^0.359.0",
    "qrcode.vue": "^3.4.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "postcss": "^8.4.38",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.7"
  }
